#####################################################################
# WASM build for emu8051-stc
# Requires: emcc (Emscripten)
# Usage:  source ~/emsdk/emsdk_env.sh && make -f Makefile.wasm
# Output: build/emu8051.js + build/emu8051.wasm
#####################################################################

EMCC := emcc

CFLAGS := -O2 -Wall -Wextra -Wno-unused-parameter

# Core source files (no curses, no TUI)
SRC := core.c opcodes.c disasm.c stc12.c debug.c wasm_api.c

OUTDIR := build
OUT := $(OUTDIR)/emu8051.js

# Exported functions (without leading underscore — emcc adds it)
EXPORTS := \
	_emu_init \
	_emu_reset \
	_emu_tick \
	_emu_run \
	_emu_load_hex \
	_emu_get_sfr \
	_emu_set_sfr \
	_emu_get_iram \
	_emu_set_iram \
	_emu_get_code \
	_emu_get_xdata \
	_emu_set_xdata \
	_emu_get_pc \
	_emu_set_pc \
	_emu_disasm \
	_emu_set_adc_input \
	_emu_set_port_input \
	_emu_set_fosc \
	_emu_set_part \
	_emu_get_pin_mode \
	_emu_get_pin_drive \
	_emu_set_pin_input \
	_emu_set_adc_voltage \
	_emu_advance_to_ns \
	_emu_get_time_ns_lo \
	_emu_get_time_ns_hi \
	_emu_set_vcc \
	_emu_set_board_callbacks \
	_emu_dbg_state \
	_emu_dbg_run \
	_emu_dbg_halt \
	_emu_dbg_step \
	_emu_dbg_reset \
	_emu_dbg_tick \
	_emu_dbg_run_until_ns \
	_emu_dbg_set_bp_code \
	_emu_dbg_set_bp_yield \
	_emu_dbg_set_bp_write \
	_emu_dbg_clear_bp \
	_emu_dbg_read_mem \
	_emu_dbg_write_mem \
	_emu_dbg_pc \
	_emu_dbg_acc \
	_emu_dbg_b \
	_emu_dbg_dptr \
	_emu_dbg_sp \
	_emu_dbg_psw \
	_emu_dbg_rn \
	_emu_dbg_bw_ms \
	_emu_dbg_task_state \
	_emu_dbg_task_until \
	_emu_dbg_set_bw_ms_addr \
	_emu_dbg_set_task \
	_emu_dbg_set_on_halt \
	_emu_dbg_profile_start \
	_emu_dbg_profile_stop \
	_emu_dbg_profile_get \
	_emu_dbg_profile_total \
	_emu_pin_history_enable \
	_emu_pin_history_count \
	_emu_pin_history_head \
	_emu_pin_history_get \
	_emu_pin_event_size \
	_emu_capabilities \
	_emu_version \
	_emu_dbg_consumes_count \
	_emu_serial_write \
	_emu_set_serial_callback \
	_emu_serial_read_buf \
	_emu_serial_read_idx \
	_emu_get_interrupt_active \
	_emu_serial2_write \
	_emu_set_serial2_callback \
	_malloc \
	_free

EXPORT_LIST := $(shell echo '$(EXPORTS)' | tr ' ' ',')

EMFLAGS := \
	-s EXPORTED_FUNCTIONS="[$(EXPORT_LIST)]" \
	-s EXPORTED_RUNTIME_METHODS="['ccall','cwrap','UTF8ToString','stringToUTF8','addFunction','removeFunction','HEAPU8','HEAPU32']" \
	-s ALLOW_TABLE_GROWTH=1 \
	-s WASM_BIGINT=1 \
	-s MODULARIZE=1 \
	-s EXPORT_NAME="createEmu8051" \
	-s ALLOW_MEMORY_GROWTH=1 \
	-s TOTAL_MEMORY=2097152 \
	-s NO_EXIT_RUNTIME=1 \
	-s ENVIRONMENT='web,worker,node'

all: $(OUT)

$(OUTDIR):
	mkdir -p $(OUTDIR)

$(OUT): $(SRC) $(wildcard *.h) | $(OUTDIR)
	$(EMCC) $(CFLAGS) $(EMFLAGS) -o $@ $(SRC)
	@# Regenerate BUILD-INFO.md so provenance always matches artifacts
	@JS=$$(sha256sum $(OUTDIR)/emu8051.js | cut -d' ' -f1); \
	 WASM=$$(sha256sum $(OUTDIR)/emu8051.wasm | cut -d' ' -f1); \
	 JS_SZ=$$(ls -lh $(OUTDIR)/emu8051.js | awk '{print $$5}'); \
	 WASM_SZ=$$(ls -lh $(OUTDIR)/emu8051.wasm | awk '{print $$5}'); \
	 VER=$$($(EMCC) --version 2>/dev/null | head -1); \
	 REV=$$(git rev-parse --short HEAD 2>/dev/null || echo unknown); \
	 DIRTY=$$(git diff --quiet HEAD -- '*.c' '*.h' 2>/dev/null || echo ' +local-changes'); \
	 { echo '# Build provenance for emu8051.js + emu8051.wasm'; \
	   echo ''; \
	   echo '| File | Size | SHA-256 |'; \
	   echo '|------|------|---------|'; \
	   printf '| emu8051.js | %s | `%s` |\n' "$$JS_SZ" "$$JS"; \
	   printf '| emu8051.wasm | %s | `%s` |\n' "$$WASM_SZ" "$$WASM"; \
	   echo ''; \
	   printf '**Emscripten:** %s\n' "$$VER"; \
	   printf '**Source:** `%s%s`\n' "$$REV" "$$DIRTY"; \
	   echo '**Licence:** MIT (emu8051 + STC12/15) + MIT/UIUC (Emscripten). No GPL.'; \
	 } > $(OUTDIR)/BUILD-INFO.md

clean:
	rm -f $(OUTDIR)/emu8051.js $(OUTDIR)/emu8051.wasm

.PHONY: all clean
